# All values are optional. Without them the app uses the testnet deployment in
# deployments/testnet.json and starts in demo mode.

# "demo" (default) or "testnet": the mode a first-time visitor sees.
NEXT_PUBLIC_DEFAULT_MODE=demo

# Point the app at another testnet deployment.
# NEXT_PUBLIC_ESCROW_CONTRACT_ID=
# NEXT_PUBLIC_USDC_CONTRACT_ID=
# NEXT_PUBLIC_USDC_ISSUER=
# NEXT_PUBLIC_FAUCET_CONTRACT_ID=
# NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org/
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet

