# Demo mode: when "true" (default), the app runs a client-side mock of the
# Soroban escrow contract so the full flow works without a wallet or testnet.
NEXT_PUBLIC_DEMO_MODE=true

# Real mode (after testnet deployment, task T2.2 / T3.3). Values must come from
# deployments/testnet.json and official Stellar docs.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=
NEXT_PUBLIC_NETWORK_PASSPHRASE=
NEXT_PUBLIC_ESCROW_CONTRACT_ID=
NEXT_PUBLIC_USDC_CONTRACT_ID=
NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet
